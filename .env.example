OPEN_NOTEBOOK_ENCRYPTION_KEY=qwertyuiop12345

# LLM Provider Toggle: set to "nvidia" or "openai"
LLM_PROVIDER=nvidia

# NVIDIA NIM / OpenAI-compatible
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# Official OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# Web Search
TAVILY_API_KEY=your-tavily-api-key-here

# Legacy Ground embeddings (must support the OpenAI "dimensions" param; stored as vector(768))
EMBEDDING_MODEL=auto

# Research engine routing (docs/engine-readiness.md). Specialists are auto-routed when their runtime is installed.
ROUTER_AUTO_STORM=auto
ROUTER_AUTO_GPT_RESEARCHER=auto
ROUTER_MAX_CONCURRENT_STORM=1
ROUTER_MAX_CONCURRENT_GPT_RESEARCHER=2
ROUTER_TURN_DEADLINE_S=1500
ROUTER_TURN_TOKEN_CEILING=1200000
# STORM runs in its own environment (requirements-storm.txt); default <repo>/venv-storm
# STORM_PYTHON=
ARQ_JOB_TIMEOUT_S=1800
ROUTER_FINALIZE_MARGIN_S=180
GROUND_TURN_STALE_AFTER_S=600
